# Jugendkompass auf dem eigenen VPS – zentrale Konfiguration.
#
# Kopieren nach /docker/jugendkompass/jugendkompass.env und ausfüllen:
#   cp jugendkompass.env.example jugendkompass.env && chmod 600 jugendkompass.env
#
# Diese Datei enthält Secrets. Nie committen, nie in einen Chat kopieren.

# --- Domains ------------------------------------------------------------------
API_DOMAIN=api.jugendkompass.com          # Supabase (REST, Auth, Storage, Functions, Studio)
WWW_DOMAIN=www.jugendkompass.com          # Flutter-Web + Share-Links + .well-known
APEX_DOMAIN=jugendkompass.com             # leitet auf www um, liefert .well-known selbst aus
ADMIN_DOMAIN=admin.jugendkompass.com      # Admin-PWA
TRANSLATE_DOMAIN=translate.jugendkompass.com  # Übersetzungs-Panel
STATUS_DOMAIN=status.jugendkompass.com    # Status-Dashboard (Login mit Admin-Konto)

# --- Traefik (bestehende Instanz auf dem VPS) -----------------------------------
# Name des externen Docker-Netzes, an dem Traefik hängt (docker network ls).
TRAEFIK_NETWORK=traefik
# Entrypoints und Let's-Encrypt-Resolver aus der Traefik-Config.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERTRESOLVER=myresolver
# Für www + Hauptdomain: "dnsresolver", wenn jugendkompass.com bei do.de liegt
# (Zertifikat dann schon vor der Umstellung). Sonst myresolver.
TRAEFIK_WWW_CERTRESOLVER=myresolver

# Lokale Ports für Postgres/Pooler (nur 127.0.0.1), frei wählen falls belegt.
JK_PG_HOST_PORT=55432
JK_POOLER_HOST_PORT=56543

# --- Supabase-Schlüssel (aus der Cloud übernehmen!) ------------------------------
# Supabase Dashboard → Project Settings → API Keys → "Legacy API keys" bzw.
# → JWT Keys → "Legacy JWT secret". Mit denselben Werten bleiben anon key,
# service key und alle Login-Sitzungen der App gültig.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# --- Studio-Login (https://API_DOMAIN/ mit Basic Auth) ---------------------------
DASHBOARD_USERNAME=matthias
DASHBOARD_PASSWORD=                       # leer = wird beim Setup generiert

# --- E-Mail für Auth (optional) -------------------------------------------------
# Die App nutzt anonyme Logins, der Admin E-Mail/Passwort ohne Bestätigungsmails.
# Nur nötig, wenn Passwort-Reset-Mails gebraucht werden (z.B. Resend SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Jugendkompass

# --- Edge Functions -------------------------------------------------------------
# Functions, die nur mit gültigem JWT aufgerufen werden dürfen (wie verify_jwt=true
# in der Cloud). Alle anderen prüfen selbst bzw. sind öffentlich.
VERIFY_JWT_FUNCTIONS=send-daily-verse-notification,send-bible-plan-notification,dispatch-message-pushes

# --- Quelle: Supabase Cloud (nur für die Migration) ------------------------------
CLOUD_PROJECT_REF=vdcdibvclaulqxfjyzpq
# Dashboard → Connect → "Session pooler" (IPv4): die dort angezeigte URI kopieren
# (Benutzer postgres.<ref>, Port 5432) und [YOUR-PASSWORD] durch das DB-Passwort ersetzen.
CLOUD_DB_URL=
# supabase.com → Account → Access Tokens (für den Download der deployten Functions).
SUPABASE_ACCESS_TOKEN=
