# Secrets für die Edge Functions auf dem VPS (entspricht "Edge Function Secrets"
# im Supabase-Dashboard). SUPABASE_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY und SUPABASE_DB_URL setzt der Stack selbst.
#
# Kopieren nach /docker/jugendkompass/functions.env, chmod 600, ausfüllen.
# Jeder Wert steht auf EINER Zeile. JSON in einfache Anführungszeichen setzen,
# Zeilenumbrüche im Private Key als \n in doppelten Anführungszeichen schreiben.

# Firebase Cloud Messaging (Push). Firebase Console → Projekteinstellungen →
# Dienstkonten → "Neuen privaten Schlüssel generieren". JSON auf eine Zeile bringen:
#   jq -c . service-account.json
FCM_PROJECT_ID=jugendkompass-46aa7
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account", ... }'
FCM_SERVICE_ACCOUNT_KEY=
# private_key aus demselben JSON (für send-bible-plan-notification)
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Übersetzung (process-translation-jobs, translate-content)
ANTHROPIC_API_KEY=
TRANSLATION_WORKER_SECRET=
# optional:
# TRANSLATION_MODEL=
# TRANSLATION_EFFORT=medium
# TRANSLATION_TIME_BUDGET_MS=100000

# Lovable AI-Gateway (translate-content, daily-stats-telegram)
LOVABLE_API_KEY=

# E-Mail bei neuen Abos (notify-new-subscription)
RESEND_API_KEY=
RESEND_FROM=

# Telegram
TELEGRAM_API_KEY=
TELEGRAM_PUSH_BOT_TOKEN=
TELEGRAM_PUSH_WEBHOOK_SECRET=
