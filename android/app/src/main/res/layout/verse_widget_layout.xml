<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <!-- Header: Book icon + VERS DES TAGES (mirrors iOS widget header) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_book_widget"
            android:contentDescription="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="VERS DES TAGES"
            android:textSize="9sp"
            android:textColor="#D94040"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- Top spacer (larger – pushes verse toward centre) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <!-- Verse text -->
    <TextView
        android:id="@+id/widget_verse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Laden..."
        android:textSize="13sp"
        android:textColor="#1A1A1A"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.35"
        android:ellipsize="end"
        android:maxLines="5" />

    <!-- Bottom spacer (smaller) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Reference aligned end, italic, secondary colour -->
    <TextView
        android:id="@+id/widget_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:textColor="#888888"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:gravity="end" />

</LinearLayout>
